<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_deep_black"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="PR ASSISTANT"
            android:textColor="@color/text_white"
            android:textSize="24sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="Assistant intelligent pour tâches Follow PR.SOCIAL"
            android:textColor="@color/text_muted"
            android:textSize="13sp" />

        <!-- Carte statistiques -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@color/surface_charcoal"
            android:orientation="vertical"
            android:padding="14dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="TABLEAU DE BORD"
                android:textColor="@color/accent_green"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvStatsToday"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Tâches aujourd'hui : 0"
                android:textColor="@color/text_white"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/tvStatsPending"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Tâches en attente : 0"
                android:textColor="@color/text_white"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/tvStatsRestrictions"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Restrictions signalées : 0"
                android:textColor="@color/alert_red"
                android:textSize="15sp" />
        </LinearLayout>

        <!-- Carte réglages délais & pause -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@color/surface_charcoal"
            android:orientation="vertical"
            android:padding="14dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="DÉLAIS VARIABLES &amp; PAUSE AUTO"
                android:textColor="@color/accent_green"
                android:textSize="12sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/etMinDelay"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:hint="Délai minimum (secondes, ex. 20)"
                android:inputType="number"
                android:textColor="@color/text_white"
                android:textColorHint="@color/text_muted" />

            <EditText
                android:id="@+id/etMaxDelay"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:hint="Délai maximum (secondes, ex. 60)"
                android:inputType="number"
                android:textColor="@color/text_white"
                android:textColorHint="@color/text_muted" />

            <EditText
                android:id="@+id/etBreakEvery"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:hint="Pause auto tous les X Follow (ex. 15)"
                android:inputType="number"
                android:textColor="@color/text_white"
                android:textColorHint="@color/text_muted" />

            <EditText
                android:id="@+id/etBreakDuration"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:hint="Durée de pause (secondes, ex. 300)"
                android:inputType="number"
                android:textColor="@color/text_white"
                android:textColorHint="@color/text_muted" />

            <Button
                android:id="@+id/btnSaveSettings"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:backgroundTint="@color/surface_charcoal"
                android:text="Enregistrer les paramètres"
                android:textColor="@color/text_white" />
        </LinearLayout>

        <!-- Boutons lancement fenêtre flottante -->
        <Button
            android:id="@+id/btnStartOverlay"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginTop="16dp"
            android:backgroundTint="@color/accent_green"
            android:text="Lancer la fenêtre flottante"
            android:textColor="@color/bg_deep_black"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnStopOverlay"
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:layout_marginTop="8dp"
            android:backgroundTint="@color/alert_red"
            android:text="Arrêter la fenêtre flottante"
            android:textColor="@color/text_white"
            android:textStyle="bold" />

    </LinearLayout>
</ScrollView>
